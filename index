<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>LMS Algoritma Pemrograman</title>
<style>
:root{--bg:#eef2f6;--card:#fff;--tx:#17233b;--mu:#5d6b82;--ac:#0b7a75;--ok:#1b8a4b;--bad:#c62f3f;--bd:#d3dbe6;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);color-scheme:light}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0f1720;--card:#17212d;--tx:#e6ecf5;--mu:#93a3ba;--ac:#3cc9bf;--ok:#4cc16e;--bad:#ff7b88;--bd:#2a3748;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#0f1720;--card:#17212d;--tx:#e6ecf5;--mu:#93a3ba;--ac:#3cc9bf;--ok:#4cc16e;--bad:#ff7b88;--bd:#2a3748;color-scheme:dark}
*,*::before,*::after{box-sizing:inherit}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--tx);font:16px/1.6 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
#app{max-width:640px;margin:0 auto;padding:16px}
a{color:var(--ac)}
h1{font-size:1.55rem;line-height:1.25;margin:.3em 0 .1em;letter-spacing:-.01em}
h2{font-size:1.1rem;line-height:1.35;margin:.2em 0 .5em}
.card{background:var(--card);border:1px solid var(--bd);border-radius:12px;padding:14px 16px;margin:10px 0}
.mu{color:var(--mu);font-size:.9rem}
.bar{height:8px;background:var(--bd);border-radius:99px;overflow:hidden}
.bar i{display:block;height:100%;background:var(--ac)}
a.btn,button{font:inherit;background:var(--ac);color:var(--bg);border:0;border-radius:10px;padding:10px 16px;text-decoration:none;display:inline-block;cursor:pointer;margin:4px 6px 4px 0;font-weight:600}
button.alt,a.btn.alt{background:transparent;color:var(--ac);border:1.5px solid var(--ac)}
button:disabled{opacity:.4;cursor:default}
:focus-visible{outline:3px solid var(--ac);outline-offset:2px}
.flow{position:relative;padding-left:50px;margin-top:16px}
.flow::before{content:"";position:absolute;left:19px;top:0;bottom:0;border-left:2px solid var(--bd)}
.step{position:relative;display:block;color:inherit;text-decoration:none;margin:12px 0}
.step .num{position:absolute;left:-50px;top:10px;width:38px;height:38px;border-radius:50%;background:var(--ac);color:var(--bg);display:grid;place-items:center;font-weight:700}
.step.lock{border-style:dashed;opacity:.65}
.step.lock .num{background:var(--bg);color:var(--mu);border:2px dashed var(--mu)}
.step.pass .num{background:var(--ok)}
.ok{color:var(--ok)}.bad{color:var(--bad)}
pre{background:var(--bg);border:1px solid var(--bd);border-radius:8px;padding:10px;overflow-x:auto;font:.88rem/1.5 ui-monospace,Menlo,Consolas,monospace}
input[type=text]{font:inherit;width:100%;padding:10px;margin:4px 0 14px;border:1px solid var(--bd);border-radius:8px;background:var(--bg);color:var(--tx)}
.opt{display:block;width:100%;text-align:left;background:var(--card);color:var(--tx);border:1px solid var(--bd);margin:8px 0;font-weight:400}
.opt.on{border-color:var(--ac);outline:2px solid var(--ac)}
.kartu{border:2px solid var(--ac);text-align:center;padding:18px 16px}
.skor{font-size:3.2rem;font-weight:800;line-height:1.1;margin-top:4px}
.kode{font:700 1.15rem ui-monospace,Menlo,Consolas,monospace;letter-spacing:.12em}
table.k{width:100%;margin-top:10px;text-align:left;font-size:.95rem;border-collapse:collapse}
table.k td{padding:3px 0;border-top:1px solid var(--bd)}
table.k td:last-child{text-align:right}
.board{position:relative;display:grid;grid-template-columns:repeat(var(--c),1fr);grid-template-rows:repeat(var(--r),1fr);width:100%;border-radius:12px;overflow:hidden;border:2px solid var(--ac);margin:10px 0}
.board i{background:var(--card);box-shadow:inset 0 0 0 1px var(--bd);display:grid;place-items:center;font-style:normal;font-size:clamp(16px,6vw,30px)}
.board i.wl{background:var(--mu)}
.rob{position:absolute;left:0;top:0;transition:left .3s,top .3s;display:grid;place-items:center;font-size:clamp(18px,7vw,34px)}
.rob u{position:absolute;inset:0;display:flex;justify-content:center;align-items:flex-start;text-decoration:none;color:var(--ac);font-size:.4em;transition:transform .3s}
.rob u::before{content:"▲"}
.tok{display:block;text-align:left;padding:6px 12px;margin:3px 0;background:var(--bg);color:var(--tx);border:1px solid var(--bd);font-weight:500}
#pal button{margin:3px 4px 3px 0;padding:8px 12px;font-size:.9rem}
.lv{display:block;position:relative;padding-left:66px;color:inherit;text-decoration:none}
.lv .num{position:absolute;left:14px;top:12px;width:38px;height:38px;border-radius:50%;background:var(--ac);color:var(--bg);display:grid;place-items:center;font-weight:700}
.lv.lock{border-style:dashed;opacity:.65}
.lv.lock .num{background:var(--bg);color:var(--mu);border:2px dashed var(--mu)}
@media (prefers-reduced-motion:reduce){.rob,.rob u{transition:none}}
</style>
</head>
<body>
<div id="app"></div>
<script>
const PASS=70;
const FORM_URL='';
const M=[
{id:'m1',t:'Konsep Algoritma',d:'Algoritma, flowchart, pseudocode',
 s:[{h:'Apa itu algoritma?',b:`<p>Algoritma adalah urutan langkah yang jelas dan berhingga untuk menyelesaikan suatu masalah. Contohnya langkah membuat teh, atau mencari bilangan terbesar dari tiga angka.</p><p>Algoritma yang baik punya input, output, langkah yang tidak ambigu, pasti berhenti, dan efektif.</p>`},
    {h:'Flowchart dan pseudocode',b:`<p>Flowchart menggambar algoritma dengan simbol: oval untuk mulai/selesai, jajar genjang untuk input/output, persegi untuk proses, belah ketupat untuk keputusan.</p><p>Pseudocode menulis langkah dengan bahasa mirip kode tetapi bebas sintaks:</p><pre>MULAI\n  BACA a, b\n  hasil ← a + b\n  TAMPILKAN hasil\nSELESAI</pre>`}],
 q:[{q:'Ciri algoritma yang benar adalah…',o:['Boleh berjalan tanpa henti','Langkahnya jelas dan berhingga','Tidak membutuhkan input','Harus memakai bahasa Python'],a:1},
    {q:'Simbol belah ketupat pada flowchart berarti…',o:['Mulai','Proses','Keputusan','Output'],a:2},
    {q:'Penulisan langkah dengan bahasa mirip kode tanpa sintaks ketat disebut…',o:['Pseudocode','Compiler','Debugging','Syntax'],a:0},
    {q:'Simbol oval pada flowchart dipakai untuk…',o:['Keputusan','Mulai atau selesai','Perhitungan','Input data'],a:1}]},
{id:'m2',t:'Variabel, Tipe Data, Operator',d:'Wadah nilai dan cara mengolahnya',
 s:[{h:'Variabel dan tipe data',b:`<p>Variabel adalah wadah bernama untuk menyimpan nilai. Tipe data umum: integer (bilangan bulat), float (desimal), string (teks), boolean (benar/salah).</p><pre>umur ← 16\nnama ← "Sari"\nlulus ← benar</pre>`},
    {h:'Operator',b:`<p>Aritmetika: + − × ÷ dan MOD (sisa bagi). Perbandingan: =, ≠, &lt;, &gt;. Logika: AND, OR, NOT.</p><p>Contoh: 17 MOD 5 menghasilkan 2.</p>`}],
 q:[{q:'Tipe data yang tepat untuk menyimpan 3,14 adalah…',o:['Integer','Float','Boolean','String'],a:1},
    {q:'Hasil dari 17 MOD 5 adalah…',o:['3','2','12','3,4'],a:1},
    {q:'Nilai boolean hanya dapat berupa…',o:['Angka 0 sampai 9','Teks bebas','Benar atau salah','Desimal'],a:2},
    {q:'Operator AND bernilai benar jika…',o:['Salah satu kondisi benar','Kedua kondisi benar','Kedua kondisi salah','Tidak ada kondisi'],a:1}]},
{id:'m3',t:'Percabangan',d:'Memilih langkah dengan if/else',
 s:[{h:'Struktur if/else',b:`<p>Percabangan memilih langkah berdasarkan kondisi.</p><pre>JIKA nilai ≥ 70 MAKA\n  TAMPILKAN "Lulus"\nSELAIN ITU\n  TAMPILKAN "Belum lulus"\nAKHIR JIKA</pre>`},
    {h:'Percabangan bertingkat',b:`<p>Gunakan SELAIN ITU JIKA untuk beberapa kondisi. Kondisi diperiksa dari atas ke bawah; yang pertama benar dijalankan dan sisanya dilewati.</p>`}],
 q:[{q:'Percabangan dipakai untuk…',o:['Mengulang langkah','Memilih langkah berdasarkan kondisi','Menyimpan data','Menghentikan program'],a:1},
    {q:'Jika nilai = 70, hasil kondisi “nilai > 70” adalah…',o:['Benar','Salah','Error','Tidak tentu'],a:1},
    {q:'Pada if/else bertingkat, kondisi diperiksa…',o:['Dari bawah ke atas','Secara acak','Dari atas sampai ada yang benar','Semuanya sekaligus'],a:2},
    {q:'Bagian yang dijalankan bila semua kondisi salah adalah…',o:['else','if','while','return'],a:0}]},
{id:'m4',t:'Perulangan',d:'for dan while',s:[],q:[]},
{id:'m5',t:'Array dan Fungsi',d:'Data berurutan dan potongan program',s:[],q:[]},
{id:'m6',t:'Searching dan Sorting Dasar',d:'Mencari dan mengurutkan data',s:[],q:[]},
{id:'m7',t:'Rekursi dan Kompleksitas',d:'Fungsi memanggil dirinya sendiri',s:[],q:[]}
];
const app=document.getElementById('app');
const blank=()=>({name:'',kelas:'',best:{},done:{},att:{}});
let S=blank(),R=null,Q=null;
try{Object.assign(S,JSON.parse(localStorage.getItem('lms')||'{}'))}catch(e){}
const save=()=>{try{localStorage.setItem('lms',JSON.stringify(S))}catch(e){}};
const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const best=m=>S.best[m.id]??-1;
const unlocked=i=>i===0||best(M[i-1])>=PASS;
const hash=s=>{let h=5381;for(const c of s)h=((h<<5)+h+c.charCodeAt(0))>>>0;return h.toString(36).toUpperCase().padStart(7,'0')};

function gate(){
  app.innerHTML=`<h1>Belajar algoritma, selangkah demi selangkah</h1><p class="mu">Isi data sekali saja. Nama dan kelas tampil di kartu hasil.</p><div class="card"><label>Nama lengkap<input type="text" id="nm" autocomplete="name"></label><label>Kelas<input type="text" id="kl" placeholder="mis. X-2"></label><p id="er" class="bad" style="margin:0 0 8px"></p><button id="go">Mulai belajar</button></div>`;
  document.getElementById('go').onclick=()=>{
    const n=nm.value.trim(),k=kl.value.trim();
    if(!n||!k){er.textContent='Isi nama dan kelas terlebih dahulu.';return}
    S.name=n;S.kelas=k;save();route();
  };
}

function home(){
  const lulus=M.filter(m=>best(m)>=PASS).length;
  app.innerHTML=`<h1>Algoritma Pemrograman</h1><p class="mu">Halo, ${esc(S.name)} (${esc(S.kelas)}). Lulus satu modul untuk membuka modul berikutnya.</p>
  <div class="card"><div class="mu" style="margin-bottom:6px">${lulus} dari ${M.length} modul lulus</div><div class="bar"><i style="width:${lulus/M.length*100}%"></i></div></div>
  <a class="card" href="#/lab" style="display:block;color:inherit;text-decoration:none;border:2px solid var(--ac)"><b>🎮 Lab Koding: Robot Penjelajah</b><br><span class="mu">Susun perintah, bawa robot ke bendera. ⭐ ${labStars()} dari ${LV.length*3}</span></a>
  <div class="flow">`+M.map((m,i)=>{
    const ok=unlocked(i),has=m.q.length>0,b=best(m);
    const st=!has?'Segera hadir':!ok?`Terkunci. Lulus modul ${i} (min. ${PASS}) untuk membuka`:b>=PASS?`<span class="ok">Lulus, skor ${b}</span>`:b>=0?`Skor terbaik ${b}, belum lulus`:'Belum dikerjakan';
    const inner=`<span class="num">${ok&&has?i+1:'🔒'}</span><b>${m.t}</b><br><span class="mu">${m.d}</span><br><span class="mu">${st}</span>`;
    return ok&&has?`<a class="card step${b>=PASS?' pass':''}" href="#/m/${m.id}">${inner}</a>`:`<div class="card step lock">${inner}</div>`;
  }).join('')+`</div><p class="mu" style="text-align:center"><a href="#" id="rs" style="color:inherit">Ganti siswa</a></p>`;
  let t=0;
  document.getElementById('rs').onclick=e=>{e.preventDefault();if(!t){t=1;e.target.textContent='Ketuk lagi untuk menghapus semua progres';return}S=blank();save();route()};
}

function modul(m){
  const d=S.done[m.id]||[];
  app.innerHTML=`<a href="#/">← Beranda</a><h1>${m.t}</h1>`+m.s.map((s,i)=>`<div class="card"><h2>${s.h}</h2>${s.b}<label class="mu"><input type="checkbox" data-i="${i}" ${d[i]?'checked':''} style="margin-right:8px">Tandai selesai</label></div>`).join('')+`<a class="btn" href="#/q/${m.id}">Mulai kuis (min. ${PASS})</a>`;
  app.querySelectorAll('input[type=checkbox]').forEach(c=>c.onchange=()=>{d[c.dataset.i]=c.checked;S.done[m.id]=d;save()});
}

function quiz(m){
  if(!Q||Q.id!==m.id)Q={id:m.id,i:0,a:[]};
  const q=m.q[Q.i],last=Q.i===m.q.length-1;
  app.innerHTML=`<a href="#/m/${m.id}">← Materi</a><p class="mu" style="margin-bottom:6px">${m.t}, soal ${Q.i+1} dari ${m.q.length}</p><div class="bar"><i style="width:${Q.i/m.q.length*100}%"></i></div><div class="card"><h2>${q.q}</h2>`+q.o.map((o,j)=>`<button class="opt${Q.a[Q.i]===j?' on':''}" data-j="${j}">${o}</button>`).join('')+`</div><button id="nx" ${Q.a[Q.i]===undefined?'disabled':''}>${last?'Selesai':'Lanjut'}</button>`;
  app.querySelectorAll('.opt').forEach(b=>b.onclick=()=>{Q.a[Q.i]=+b.dataset.j;quiz(m)});
  document.getElementById('nx').onclick=()=>{if(!last){Q.i++;quiz(m);return}finish(m)};
}

function finish(m){
  const ok=m.q.filter((q,i)=>Q.a[i]===q.a).length,sk=Math.round(ok/m.q.length*100);
  S.att[m.id]=(S.att[m.id]||0)+1;S.best[m.id]=Math.max(best(m),sk);save();
  const ts=new Date().toLocaleString('id-ID',{dateStyle:'medium',timeStyle:'short'});
  R={id:m.id,sk,ok,n:m.q.length,att:S.att[m.id],ts,kode:hash([S.name,S.kelas,m.id,sk,ts].join('|'))};
  Q=null;location.hash='#/r';
}

function hasil(){
  if(!R){location.hash='#/';return}
  const i=M.findIndex(m=>m.id===R.id),m=M[i],p=R.sk>=PASS,nx=M[i+1];
  app.innerHTML=`<div class="card kartu"><div class="mu">Kartu hasil, LMS Algoritma</div><h2 style="margin-top:6px">${esc(S.name)}, ${esc(S.kelas)}</h2><div class="mu">${m.t}</div><div class="skor ${p?'ok':'bad'}">${R.sk}</div><b class="${p?'ok':'bad'}">${p?'Lulus':'Belum lulus'}</b> <span class="mu">(minimum ${PASS})</span><table class="k"><tr><td>Jawaban benar</td><td>${R.ok} dari ${R.n}</td></tr><tr><td>Percobaan ke</td><td>${R.att}</td></tr><tr><td>Waktu</td><td>${R.ts}</td></tr></table><div class="mu" style="margin-top:10px">Kode verifikasi</div><div class="kode">${R.kode}</div></div><p class="mu">Screenshot kartu di atas${FORM_URL?', lalu kirim ke Google Form.':'.'}</p>${FORM_URL?`<a class="btn" href="${FORM_URL}" target="_blank" rel="noopener">Buka Google Form</a>`:''}`+(p&&nx&&nx.q.length?`<a class="btn alt" href="#/m/${nx.id}">Modul berikutnya</a>`:'')+`<a class="btn alt" href="#/q/${m.id}">Coba lagi</a><a class="btn alt" href="#/">Beranda</a>`;
}

const TK={F:'⬆ Maju',L:'↺ Putar kiri',R:'↻ Putar kanan',REP2:'🔁 Ulangi 2×',REP3:'🔁 Ulangi 3×',REP4:'🔁 Ulangi 4×',WHILE:'🔁 Selama depan kosong',END:'⏹ Akhir blok'};
const BASIC=['F','L','R'],LOOPS=['F','L','R','REP2','REP3','REP4','END'];
const LV=[
{n:'Langkah pertama',h:'Urutan: robot menjalankan perintah dari atas ke bawah.',g:['S....','.....','....G'],d:2,par:7,ok:BASIC},
{n:'Tangga',h:'Pola yang berulang bisa dibungkus dengan Ulangi.',g:['S....','.....','.....','.....','....G'],d:1,par:6,ok:LOOPS},
{n:'Jalan memutar',h:'Tembok menghalangi, jadi robot harus memutar. Cobalah hemat blok.',g:['S.#.G','..#..','..#..','.....','.....'],d:2,par:11,ok:LOOPS},
{n:'Lorong panjang',h:'Selama: mengulang terus selagi kondisinya benar, tanpa menghitung langkah.',g:['.......','S.....G','.......'],d:1,par:3,ok:['F','L','R','WHILE','END']},
{n:'Ular',h:'Gabungkan semuanya: urutan, ulangi, dan selama.',g:['S....','####.','.....','.####','G....'],d:1,par:13,ok:Object.keys(TK)}
];
let LP=[],LI=0,LT=null;
const lstar=i=>(S.lab&&S.lab[i])||0;
const labStars=()=>LV.reduce((a,_,i)=>a+lstar(i),0);
const DX=[0,1,0,-1],DY=[-1,0,1,0];
function lab(id){clearInterval(LT);const i=+id;if(id===undefined||id===''||!(i>=0&&i<LV.length)||(i>0&&!lstar(i-1)))return labList();LI=i;LP=[];labLevel()}
function labList(){
  app.innerHTML=`<a href="#/">← Beranda</a><h1>Lab Koding: Robot Penjelajah</h1><p class="mu">Susun perintah agar robot sampai ke bendera. Makin sedikit blok yang dipakai, makin banyak bintang.</p>`+LV.map((v,i)=>{const op=i===0||lstar(i-1)>0,s=lstar(i);const inner=`<span class="num">${op?i+1:'🔒'}</span><b>${v.n}</b><br><span class="mu">${op?'⭐'.repeat(s)+'☆'.repeat(3-s):'Selesaikan level sebelumnya'}</span>`;return op?`<a class="card lv" href="#/lab/${i}">${inner}</a>`:`<div class="card lv lock">${inner}</div>`}).join('');
}
function gridOf(v){let s,gl,w=[];v.g.forEach((r,y)=>[...r].forEach((c,x)=>{if(c==='S')s=[x,y];if(c==='G')gl=[x,y];if(c==='#')w.push(x+','+y)}));return{R:v.g.length,C:v.g[0].length,s,gl,w}}
function parse(){const root=[],st=[root];for(const k of LP){const cur=st[st.length-1];if(k==='END'){if(st.length>1)st.pop();continue}if(k.startsWith('REP')){const n={t:'rep',n:+k[3],b:[]};cur.push(n);st.push(n.b)}else if(k==='WHILE'){const n={t:'while',b:[]};cur.push(n);st.push(n.b)}else cur.push({t:k})}return root}
function sim(G,d0){
  let x=G.s[0],y=G.s[1],a=d0*90,out=[{x,y,a}],err='',n=0;
  const dir=()=>((a/90)%4+4)%4;
  const free=()=>{const d=dir(),nx=x+DX[d],ny=y+DY[d];return nx>=0&&ny>=0&&nx<G.C&&ny<G.R&&!G.w.includes(nx+','+ny)};
  const ex=ns=>{for(const o of ns){if(err)return;if(++n>400){err='long';return}
    if(o.t==='F'){if(!free()){err='bump';return}x+=DX[dir()];y+=DY[dir()];out.push({x,y,a})}
    else if(o.t==='L'){a-=90;out.push({x,y,a})}
    else if(o.t==='R'){a+=90;out.push({x,y,a})}
    else if(o.t==='rep'){for(let i=0;i<o.n&&!err;i++)ex(o.b)}
    else if(o.t==='while'){if(!o.b.length){err='long';return}while(!err&&free())ex(o.b)}}};
  ex(parse());return{out,err,x,y};
}
function drawProg(){
  let d=0;const p=document.getElementById('prog');
  p.innerHTML=LP.length?LP.map((k,i)=>{if(k==='END')d=Math.max(0,d-1);const h=`<button class="tok" data-i="${i}" style="margin-left:${d*18}px">${TK[k]} ✕</button>`;if(/^(REP|WHILE)/.test(k))d++;return h}).join(''):'<span class="mu">Program masih kosong. Ketuk tombol perintah di bawah. Ketuk perintah di sini untuk menghapusnya.</span>';
  p.onclick=e=>{const b=e.target.closest('[data-i]');if(b){LP.splice(+b.dataset.i,1);drawProg()}};
}
function labLevel(){
  const v=LV[LI],G=gridOf(v);let cells='';
  for(let y=0;y<G.R;y++)for(let x=0;x<G.C;x++)cells+=`<i class="${G.w.includes(x+','+y)?'wl':''}">${G.gl[0]===x&&G.gl[1]===y?'🏁':''}</i>`;
  app.innerHTML=`<a href="#/lab">← Level</a><h1>Level ${LI+1}: ${v.n}</h1><p class="mu">${v.h}</p><div class="board" style="--c:${G.C};--r:${G.R};aspect-ratio:${G.C}/${G.R}">${cells}<div id="rob" class="rob" style="width:${100/G.C}%;height:${100/G.R}%"><span>🤖</span><u id="arw"></u></div></div><div id="msg" class="card">Susun perintah, lalu tekan Jalankan. Target: ${v.par} blok atau kurang untuk 3 bintang.</div><div class="card" id="prog"></div><div id="pal">${v.ok.map(k=>`<button class="alt" data-k="${k}">${TK[k]}</button>`).join('')}</div><button id="run">▶ Jalankan</button><button class="alt" id="clr">Hapus semua</button>`;
  const rob=document.getElementById('rob'),arw=document.getElementById('arw'),msg=document.getElementById('msg');
  const setRob=s=>{rob.style.left=s.x*100/G.C+'%';rob.style.top=s.y*100/G.R+'%';arw.style.transform=`rotate(${s.a}deg)`};
  const home0={x:G.s[0],y:G.s[1],a:v.d*90};setRob(home0);drawProg();
  document.getElementById('pal').onclick=e=>{const k=e.target.dataset.k;if(k&&LP.length<30){LP.push(k);drawProg()}};
  document.getElementById('clr').onclick=()=>{clearInterval(LT);LP=[];drawProg();setRob(home0)};
  document.getElementById('run').onclick=()=>{
    if(!LP.length)return;clearInterval(LT);const r=sim(G,v.d);let i=0;setRob(r.out[0]);msg.textContent='Robot berjalan…';
    LT=setInterval(()=>{
      if(++i<r.out.length){setRob(r.out[i]);return}
      clearInterval(LT);
      if(!r.err&&r.x===G.gl[0]&&r.y===G.gl[1]){
        const n=LP.length,s=n<=v.par?3:n<=v.par+3?2:1;S.lab=S.lab||{};S.lab[LI]=Math.max(lstar(LI),s);save();
        msg.innerHTML=`<b class="ok">Berhasil! ${'⭐'.repeat(s)}</b><br>${n} blok (target ${v.par}).<br>`+(LI<LV.length-1?`<a class="btn" href="#/lab/${LI+1}">Level berikutnya</a>`:`<b>Semua level selesai. Hebat!</b>`);
      }else msg.textContent=r.err==='bump'?'Robot menabrak tembok atau batas papan. Periksa lagi perintahmu.':r.err==='long'?'Program terlalu lama, mungkin ada perulangan yang tidak berujung.':'Robot belum sampai di bendera. Coba lagi.';
    },350);
  };
}
function route(){
  scrollTo(0,0);
  if(!S.name)return gate();
  const [,t,id]=location.hash.slice(1).split('/'),i=M.findIndex(m=>m.id===id),m=M[i];
  if(t==='r')return hasil();
  if(t==='lab')return lab(id);
  if((t==='m'||t==='q')&&m&&m.q.length&&unlocked(i)){
    if(t==='m'){Q=null;return modul(m)}
    return quiz(m);
  }
  home();
}
addEventListener('hashchange',route);
route();
</script>
